    TorsoColor = true
}

local function getCurrentHumanoid()
    local char = player.Character
    if not char then return nil end

    return char:FindFirstChildOfClass("Humanoid")
end

-- Serialize current outfit

local function captureOutfit()
    local currentHumanoid = getCurrentHumanoid()

    if not currentHumanoid then
        return nil, "Character not found"
    end

    local success, description = pcall(function()
        return currentHumanoid:GetAppliedDescription()
    end)

    if not success or not description then
        return nil, "Could not get HumanoidDescription"
    end

    local data = {
        Properties = {},
        Accessories = {},
    }

	data.Assets = table.clone(wornAssetIds)

    for _, property in ipairs(DESCRIPTION_PROPERTIES) do
        local ok, value = pcall(function()
            return description[property]
        end)

        if ok then
            if COLOR_PROPERTIES[property] then
                data.Properties[property] = {
                    R = value.R,
                    G = value.G,
                    B = value.B
                }
            else
                data.Properties[property] = value
            end
        end
    end

    local accessoriesOK, accessories = pcall(function()
        return description:GetAccessories(true)
    end)

    if accessoriesOK then
        for _, accessory in ipairs(accessories) do
            table.insert(data.Accessories, {
                AssetId = accessory.AssetId,
                AccessoryType = accessory.AccessoryType.Name,
                IsLayered = accessory.IsLayered,
                Order = accessory.Order,
                Puffiness = accessory.Puffiness
            })
        end
    end

    description:Destroy()

    return data
end

-- Save outfit

local function saveOutfit(name)
    name = safeName(name)

    if name == "" then
        log("Invalid outfit name", true)
        return false
    end

    if not ensureFolders() then
        log("File API unavailable", true)
        return false
    end

    local data, err = captureOutfit()

    if not data then
        log(err, true)
        return false
    end

    local ok, result = pcall(function()
        writefile(
            outfitPath(name),
            HttpService:JSONEncode(data)
        )
    end)

    if not ok then
        log("Failed to save: " .. tostring(result), true)
        return false
    end

    config.lastOutfit = name
    saveConfig()

    log("Saved outfit: " .. name, false)
    return true
end

-- Load outfit

local function loadOutfit(name, silent)
    name = safeName(name)

    if name == "" then
        if not silent then
            log("Enter an outfit name", true)
        end
        return false
    end

    if not ensureFolders() then
        if not silent then
            log("File API unavailable", true)
        end
        return false
    end

    local path = outfitPath(name)

    if not isfile(path) then
        if not silent then
            log("Outfit not found: " .. name, true)
        end
        return false
    end

    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)

    if not ok or type(data) ~= "table" then
        log("Invalid outfit file", true)
        return false
    end

    local currentHumanoid = getCurrentHumanoid()

    if not currentHumanoid then
        log("Character not found", true)
        return false
    end

    local description = Instance.new("HumanoidDescription")

    -- Restore properties

    for property, value in pairs(data.Properties or {}) do
        pcall(function()
            if COLOR_PROPERTIES[property] then
                description[property] = Color3.new(
                    value.R,
                    value.G,
                    value.B
                )
            else
                description[property] = value
            end
        end)
    end

    -- Restore layered and classic accessories

    local accessories = {}

    for _, item in ipairs(data.Accessories or {}) do
        local accessoryType = Enum.AccessoryType[item.AccessoryType]

        if accessoryType then
            table.insert(accessories, {
                AssetId = item.AssetId,
                AccessoryType = accessoryType,
                IsLayered = item.IsLayered == true,
                Order = item.Order or 0,
                Puffiness = item.Puffiness or 0
            })
        end
    end

    pcall(function()
        description:SetAccessories(accessories, true)
    end)

    -- Apply to character

    local applied, applyError = pcall(function()
        currentHumanoid:ApplyDescription(description)
    end)

	description:Destroy()
	
	if not applied then
	    log("Apply failed: " .. tostring(applyError), true)
	    return false
	end
	
	-- Restore manually loaded assets
	
	wornAssetIds = {}
	isRestoringOutfit = true
	
	for _, assetId in ipairs(data.Assets or {}) do
	    local ok, err = wearAsset(assetId)
	
	    if not ok then
	        log("Asset restore failed: " .. tostring(assetId), true)
	    end
	end
	
	isRestoringOutfit = false
	
	config.lastOutfit = name
	saveConfig()
	
	log("Loaded outfit: " .. name, false)
	return true
end

-- Delete outfit

local function deleteOutfit(name)
    name = safeName(name)

    if name == "" then
        log("Enter an outfit name", true)
        return false
    end

    local path = outfitPath(name)

    if not isfile(path) then
        log("Outfit not found: " .. name, true)
        return false
    end

    local ok, err = pcall(function()
        delfile(path)
    end)

    if not ok then
        log("Delete failed: " .. tostring(err), true)
        return false
    end

    if config.lastOutfit == name then
        config.lastOutfit = ""
        config.autoLoad = false
        saveConfig()
        AutoLoadBtn.Text = "Auto Load: OFF"
    end

    log("Deleted outfit: " .. name, false)
    return true
end

